# Copie este arquivo para .env apenas para desenvolvimento local.
# Todos os valores CHANGE_ME são placeholders e devem ser substituídos.

CORE_DB_NAME=vehicle_core
CORE_DB_USER=core_app
CORE_DB_PASSWORD=CHANGE_ME_CORE_DB_PASSWORD
CORE_DB_ROOT_PASSWORD=CHANGE_ME_CORE_DB_ROOT_PASSWORD

SALES_DB_NAME=vehicle_sales
SALES_DB_USER=sales_app
SALES_DB_PASSWORD=CHANGE_ME_SALES_DB_PASSWORD
SALES_DB_ROOT_PASSWORD=CHANGE_ME_SALES_DB_ROOT_PASSWORD

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
SERVICE_TOKEN=CHANGE_ME_SHARED_INTERNAL_SERVICE_TOKEN
WEBHOOK_SECRET=CHANGE_ME_EXTERNAL_WEBHOOK_SECRET

LOG_LEVEL=INFO
CORE_HOST_PORT=8000
SALES_HOST_PORT=8001

